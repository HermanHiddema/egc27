<% content_for :title, "Add a participant ticket – EGC 2027" %>
<div class="container-wide py-8 lg:py-12 max-w-4xl">
  <p><%= link_to "Back to shopping basket", basket_return_path, class: "text-brand-blue-700 underline" %></p>
  <h1 class="text-3xl font-bold mt-3 mb-6">Add a participant ticket</h1>
  <section class="bg-white border border-gray-200 rounded-lg p-5 md:p-7 shadow-sm mb-6">
    <h2 class="text-xl font-semibold text-brand-blue-900 mb-2">Register a new participant</h2>
    <p class="text-neutral-700 mb-4"><%= @admin_basket ? "Use the registration form to add a participant to #{@order.user.display_name}’s account and basket." : "Use the registration form to add another participant to your account and basket." %></p>
    <%= link_to "Register a new Participant", basket_registration_path, class: "btn-primary" %>
  </section>
  <section class="bg-white border border-gray-200 rounded-lg p-5 md:p-7 shadow-sm">
    <h2 class="text-xl font-semibold text-brand-blue-900 mb-4">Select an existing participant</h2>
    <% if @admin_basket %>
      <%= render "shared/remote_select", url: participants_admin_order_path(@order), submit_url: add_participant_admin_order_path(@order), name: "participant_id", label: "Participant", submit_label: "Add ticket" %>
    <% else %>
      <%= render "orders/participant_choices" %>
    <% end %>
  </section>
</div>
