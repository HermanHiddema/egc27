<% if @order.submitted? %>
  <%= render "submitted_order" %>
<% else %>
  <% content_for :title, "Shopping basket – EGC 2027" %>
  <div class="container-wide py-8 lg:py-12">
    <div class="flex flex-wrap justify-between items-end gap-4 mb-8">
      <div>
        <h1 class="text-4xl font-bold">Shopping basket</h1>
        <p class="mt-2 text-neutral-700">Review your participants and hostel bookings before checkout.</p>
      </div>
      <%= link_to "Past Orders", submitted_orders_path, class: "text-brand-blue-700 underline" %>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-[1fr_20rem] gap-8 items-start">
      <div class="space-y-8">
        <% ticket_products = @products.select { |product| product.productable.is_a?(ParticipantTicket) } %>
        <% hostel_products = @products.select { |product| product.productable.is_a?(HostelBooking) } %>
        <section class="bg-white border border-gray-200 rounded-lg p-5 md:p-7 shadow-sm">
          <div class="flex justify-between items-center gap-3 mb-4">
            <h2 class="text-xl font-semibold text-brand-blue-900">Participant tickets</h2>
            <%= link_to "#{ticket_products.any? ? 'Add another' : 'Add'} #{ParticipantTicket.display_name}", new_participant_order_path, class: "btn-secondary text-sm" %>
          </div>
          <% if ticket_products.any? %>
            <ul class="divide-y divide-gray-200">
              <% ticket_products.each do |product| %>
                <% ticket = product.productable; participant = ticket.participant %>
                <% pricing = CongressPassPricing.new(attendance_option: participant.attendance_option, age_group: participant.age_group) %>
                <li class="py-4 flex flex-wrap items-center justify-between gap-4">
                  <div class="min-w-0">
                    <%= link_to "#{participant.first_name} #{participant.last_name}", participant_path(participant), class: "font-semibold text-brand-blue-800 hover:underline" %>
                    <p class="text-sm text-neutral-600">
                      <%= pricing.attendance_label %> · age <%= participant.age_group %><% if pricing.discount_fraction.positive? %> · <%= number_to_percentage(pricing.discount_fraction * 100, precision: 0) %> discount<% end %>
                    </p>
                  </div>
                  <div class="ml-auto flex shrink-0 items-center gap-4">
                    <div class="flex items-center gap-1">
                      <%= link_to edit_product_order_path(product_id: product.id), class: "rounded p-2 text-brand-blue-700 hover:bg-brand-blue-50", aria: { label: "Edit participant ticket for #{participant.first_name} #{participant.last_name}" }, title: "Edit participant ticket" do %>
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 2.651 2.651M7.5 20.25l4.707-.942L20.25 11.265a2.121 2.121 0 0 0-3-3L9.207 16.308 8.25 21l-.75-.75Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5v5.25A2.25 2.25 0 0 1 17.25 21h-10.5A2.25 2.25 0 0 1 4.5 18.75V6.75A2.25 2.25 0 0 1 6.75 4.5H12"/></svg>
                      <% end %>
                      <%= button_to remove_product_order_path(product_id: product.id), method: :delete, class: "rounded p-2 text-red-700 hover:bg-red-50", aria: { label: "Remove participant ticket for #{participant.first_name} #{participant.last_name}" }, title: "Remove participant ticket", form: { data: { turbo_confirm: "Remove this ticket from your shopping basket? The participant registration will be kept." } } do %>
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 7.5h15m-13.5 0 .75 12h10.5l.75-12M9 7.5V4.875A1.875 1.875 0 0 1 10.875 3h2.25A1.875 1.875 0 0 1 15 4.875V7.5m-6 3v5.25m6-5.25v5.25"/></svg>
                      <% end %>
                    </div>
                    <span class="whitespace-nowrap text-lg font-bold text-brand-blue-900">€ <%= format("%.2f", product.price_cents / 100.0) %></span>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-neutral-600">No participant tickets in your basket.</p>
          <% end %>
        </section>

        <section class="bg-white border border-gray-200 rounded-lg p-5 md:p-7 shadow-sm">
          <div class="flex justify-between items-center gap-3 mb-4">
            <h2 class="text-xl font-semibold text-brand-blue-900">Hostel bookings</h2>
            <%= link_to "#{hostel_products.any? ? 'Add another' : 'Add'} #{HostelBooking.display_name}", new_hostel_booking_path, class: "btn-secondary text-sm" %>
          </div>
          <% if hostel_products.any? %>
            <ul class="divide-y divide-gray-200">
              <% hostel_products.each do |product| %>
                <% booking = product.productable %>
                <li class="py-4 flex flex-wrap items-center justify-between gap-4">
                  <div class="min-w-0">
                    <%= link_to "Hostel booking · #{eu_date_range(booking.arrival_date, booking.departure_date)}", hostel_booking_path(booking), class: "font-semibold text-brand-blue-800 hover:underline" %>
                    <p class="text-sm text-neutral-600"><%= booking.nights %> nights · <%= hostel_booking_options(booking) %></p>
                  </div>
                  <div class="ml-auto flex shrink-0 items-center gap-4">
                    <div class="flex items-center gap-1">
                      <%= link_to edit_hostel_booking_path(booking), class: "rounded p-2 text-brand-blue-700 hover:bg-brand-blue-50", aria: { label: "Edit hostel booking" }, title: "Edit hostel booking" do %>
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m16.862 4.487 2.651 2.651M7.5 20.25l4.707-.942L20.25 11.265a2.121 2.121 0 0 0-3-3L9.207 16.308 8.25 21l-.75-.75Z"/><path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5v5.25A2.25 2.25 0 0 1 17.25 21h-10.5A2.25 2.25 0 0 1 4.5 18.75V6.75A2.25 2.25 0 0 1 6.75 4.5H12"/></svg>
                      <% end %>
                      <%= button_to hostel_booking_path(booking), method: :delete, class: "rounded p-2 text-red-700 hover:bg-red-50", aria: { label: "Remove hostel booking" }, title: "Remove hostel booking", form: { data: { turbo_confirm: "Remove this provisional hostel booking from your shopping basket?" } } do %>
                        <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M4.5 7.5h15m-13.5 0 .75 12h10.5l.75-12M9 7.5V4.875A1.875 1.875 0 0 1 10.875 3h2.25A1.875 1.875 0 0 1 15 4.875V7.5m-6 3v5.25m6-5.25v5.25"/></svg>
                      <% end %>
                    </div>
                    <span class="whitespace-nowrap text-lg font-bold text-brand-blue-900">€ <%= format("%.2f", product.price_cents / 100.0) %></span>
                  </div>
                </li>
              <% end %>
            </ul>
          <% else %>
            <p class="text-neutral-600">No hostel bookings in your basket.</p>
          <% end %>
        </section>

        <% if @products.empty? %>
          <div class="rounded-lg border border-brand-yellow-300 bg-brand-yellow-50 p-5 text-brand-yellow-950">
            <p class="font-semibold">Your shopping basket is empty.</p>
            <p class="mt-1">Add a participant ticket or book hostel accommodation to get started.</p>
          </div>
        <% end %>
      </div>

      <aside class="bg-white border border-gray-200 rounded-lg p-5 md:p-6 shadow-sm lg:sticky lg:top-24">
        <h2 class="text-xl font-semibold text-brand-blue-900 mb-4">Order summary</h2>
        <div class="flex justify-between border-t border-gray-200 pt-4 text-lg font-bold text-brand-blue-900">
          <span>Total: € <%= format("%.2f", @order.total_cents / 100.0) %></span>
        </div>
        <% if @products.any? && !current_user.confirmed? && ticket_products.any? %>
          <p class="mt-4 text-sm text-amber-800">Confirm your email address before paying for participant tickets.</p>
        <% end %>
        <% if @products.any? %>
          <%= form_with url: submit_order_path, method: :post, data: { turbo: false }, class: "mt-5" do |form| %>
            <%= form.hidden_field :confirmed_total_cents, value: @order.total_cents %>
            <%= form.submit "Book with commitment to pay", class: "w-full btn-primary py-3 text-center", disabled: @requires_confirmation %>
          <% end %>
          <p class="mt-3 text-xs text-neutral-500">Payment is for the full order. Available payment methods are shown by Mollie.</p>
        <% else %>
          <button class="w-full btn-primary py-3 mt-5 opacity-50 cursor-not-allowed" disabled>Book with commitment to pay</button>
          <div class="mt-4 space-y-2 text-sm">
            <%= link_to "Register a participant", new_participant_path(return_to: order_path), class: "block text-brand-blue-700 underline" %>
            <%= link_to "Book hostel accommodation", new_hostel_booking_path, class: "block text-brand-blue-700 underline" %>
          </div>
        <% end %>
        <% if @show_simulation_controls && @products.any? %>
          <%= render "simulation_controls", url: submit_order_path,
                request_params: { confirmed_total_cents: @order.total_cents } %>
        <% end %>
      </aside>
    </div>

    <% if @products.any? %>
      <div class="mt-8 flex justify-end">
        <%= button_to "Empty shopping basket", empty_order_path, method: :delete, class: "btn-accent", form: { data: { turbo_confirm: "Empty your shopping basket? Participant registrations will be kept; provisional tickets and hostel bookings will be removed." } } %>
      </div>
    <% end %>
  </div>
<% end %>
