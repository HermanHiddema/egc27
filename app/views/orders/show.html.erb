<div class="mx-auto max-w-4xl px-4 py-6">
  <h1 class="text-2xl font-bold text-brand-blue-900"><%= @order.draft? ? "Review your order" : "Order awaiting payment" %></h1>
  <% if @order.draft? && @products.any? %>
    <p class="mt-2 text-gray-700">Review all items and the full order total before continuing to payment.</p>
  <% end %>
  <% if @requires_confirmation %>
    <div class="mt-4 rounded-lg border border-yellow-300 bg-yellow-50 p-4 text-yellow-900">
      Please confirm your email address before paying for tickets. Return to this page after confirming.
    </div>
  <% end %>

  <% if @products.empty? %>
    <p class="mt-4 text-gray-700">Your basket is empty.</p>
  <% else %>
    <div class="mt-6 divide-y rounded-lg border bg-white">
      <% @products.each do |product| %>
        <div class="flex items-center justify-between gap-4 p-4">
          <div>
            <p class="font-semibold">
              <% if product.productable.is_a?(ParticipantTicket) %>
                Participant ticket: <%= product.productable.participant.first_name %> <%= product.productable.participant.last_name %>
              <% else %>
                <%= product.productable.description %>
              <% end %>
            </p>
            <p>€ <%= format("%.2f", product.price_cents / 100.0) %></p>
          </div>
        </div>
      <% end %>
    </div>
    <p class="mt-4 text-right text-lg font-bold">Total: € <%= format("%.2f", @order.total_cents / 100.0) %></p>
    <% if @order.draft? %>
      <div class="mt-4 flex flex-wrap items-center justify-end gap-4">
        <%= button_to "Cancel entire order", cancel_order_path, method: :delete,
              form: { data: { turbo_confirm: "Cancel this order and remove all its items?" } },
              class: "btn-accent cursor-pointer" %>
        <% unless @requires_confirmation %>
          <%= button_to "Continue to payment", submit_order_path, method: :post,
                form: { data: { turbo: false } }, class: "btn-primary" %>
        <% end %>
      </div>
    <% else %>
      <% if @latest_payment %>
        <p class="mt-4 text-sm text-neutral-600">Latest payment attempt: <%= @latest_payment.status.humanize %>.</p>
      <% end %>
      <% unless @order.closed? %>
        <%= button_to "Continue to payment", pay_submitted_order_path(@order), method: :post, form: { data: { turbo: false } }, class: "btn-primary mt-4" %>
      <% end %>
    <% end %>
    <% if @show_simulation_controls %>
      <% simulation_path = @order.draft? ? submit_order_path : pay_submitted_order_path(@order) %>
      <div class="mt-5 rounded-lg border border-brand-yellow-300 bg-brand-yellow-50 p-4">
        <h2 class="mb-3 text-sm font-semibold text-brand-yellow-900">Development: Simulate Mollie Response</h2>
        <div class="grid grid-cols-1 gap-2 sm:grid-cols-2">
          <% %w[paid pending failed canceled].each do |simulated_status| %>
            <%= button_to "Simulate #{simulated_status}", simulation_path, method: :post,
                  params: { simulate_status: simulated_status }, form: { data: { turbo: false } },
                  class: simulated_status == "paid" ? "btn-primary w-full" : "btn-secondary w-full" %>
          <% end %>
        </div>
      </div>
    <% end %>
  <% end %>
</div>
