<% content_for :title, "Edit participant ticket – EGC 2027" %>
<div class="container-wide py-8 lg:py-12 max-w-3xl">
  <p><%= link_to "Back to shopping basket", order_path, class: "text-brand-blue-700 underline" %></p>
  <h1 class="text-3xl font-bold mt-3 mb-6">Edit ticket for <%= @participant.first_name %> <%= @participant.last_name %></h1>
  <div class="bg-white border border-gray-200 rounded-lg p-5 md:p-7 shadow-sm">
    <% if @participant.errors.any? %><div class="mb-5 rounded bg-red-50 p-4 text-red-800"><%= @participant.errors.full_messages.to_sentence %></div><% end %>
    <%= form_with model: @participant, url: update_product_order_path(product_id: @product.id), method: :patch, class: "space-y-5" do |form| %>
      <% unless @participant.valid_admission? %>
        <div class="grid gap-4 sm:grid-cols-2">
          <div><%= form.label :first_name, "First name *", class: "block text-sm font-medium mb-1" %><%= form.text_field :first_name, class: "w-full rounded border-gray-300" %></div>
          <div><%= form.label :last_name, "Last name *", class: "block text-sm font-medium mb-1" %><%= form.text_field :last_name, class: "w-full rounded border-gray-300" %></div>
          <div><%= form.label :age_group, "Age group *", class: "block text-sm font-medium mb-1" %><%= form.select :age_group, [["0–11", "0-11"], ["12–17", "12-17"], ["18–49", "18-49"], ["50+", "50+"]], {}, class: "w-full rounded border-gray-300" %><p class="text-xs text-neutral-600">Age on 24 July 2027.</p></div>
          <div><%= form.label :attendance_option, "Attendance period *", class: "block text-sm font-medium mb-1" %><%= form.select :attendance_option, [["All events", "all_events"], ["Week 1 + Weekend", "first_week_plus_weekend"], ["Weekend + Week 2", "weekend_plus_second_week"], ["Weekend Only", "weekend_only"]], {}, class: "w-full rounded border-gray-300" %></div>
        </div>
      <% else %>
        <p class="rounded bg-green-50 p-3 text-sm text-green-900">A valid paid ticket exists. Ticket price and attendance details are locked.</p>
      <% end %>
      <div class="grid gap-4 sm:grid-cols-2">
        <div><%= form.label :country, "Country *", class: "block text-sm font-medium mb-1" %><%= form.text_field :country, class: "w-full rounded border-gray-300", maxlength: 2 %><p class="text-xs text-neutral-600">Enter the ISO alpha-2 country code.</p></div>
        <div><%= form.label :gender, "Gender *", class: "block text-sm font-medium mb-1" %><%= form.select :gender, [["Male", "male"], ["Female", "female"], ["Non-Binary", "non_binary"], ["Prefer not to say", "prefer_not_to_say"]], {}, class: "w-full rounded border-gray-300" %></div>
        <div><%= form.label :club, "Club", class: "block text-sm font-medium mb-1" %><%= form.text_field :club, class: "w-full rounded border-gray-300" %></div>
      </div>
      <fieldset><legend class="text-sm font-medium mb-2">Photo privacy choice *</legend><label class="mr-4"><%= form.radio_button :image_use_consent, true %> I consent</label><label><%= form.radio_button :image_use_consent, false %> I do not consent</label></fieldset>
      <div class="flex gap-3"><%= form.submit "Save changes", class: "btn-primary" %><%= link_to "Cancel", order_path, class: "px-4 py-2 text-brand-blue-700" %></div>
    <% end %>
  </div>
</div>
