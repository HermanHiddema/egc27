<%= form_with model: newsletter,
              class: "space-y-6",
              data: {
                controller: "newsletter-send",
                action: "submit->newsletter-send#confirm",
                newsletter_send_recipient_count_value: @recipient_count
              } do |form| %>
  <% if newsletter.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4" role="alert">
      <h2 class="text-red-800 font-semibold mb-2">There were errors with your newsletter:</h2>
      <ul class="text-red-700 list-disc list-inside">
        <% newsletter.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div>
    <%= form.label :title, "Newsletter title *", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_field :title, required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-brand-blue-600 focus:border-brand-blue-600" %>
  </div>

  <div>
    <%= form.label :subject, "Email subject *", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <%= form.text_field :subject, required: true, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-brand-blue-600 focus:border-brand-blue-600" %>
  </div>

  <div>
    <%= form.label :content_html, "Newsletter content *", class: "block text-sm font-medium text-gray-700 mb-2" %>
    <% content_for :tinymce_script, "1" %>
    <%= form.text_area :content_html,
                       rows: 18,
                       data: {
                         controller: "tinymce",
                         tinymce_script_url_value: tinymce_script_url,
                         tinymce_plugins_value: "lists link image autoresize",
                         tinymce_toolbar_value: "undo redo | blocks | bold italic underline | forecolor backcolor | alignleft aligncenter alignright | bullist numlist | link image | removeformat"
                       },
                       class: "w-full rounded-lg border border-gray-300 bg-white" %>
    <p class="text-sm text-gray-500 mt-2">Content will use a simple, single-column email layout. Use headings, text formatting, links, lists, and images. Uploaded images are hosted by this site.</p>
  </div>

  <div class="flex flex-wrap gap-3">
    <%= form.hidden_field :recipient_count, name: "recipient_count", value: @recipient_count %>
    <%= form.hidden_field :confirmed_send, name: "confirmed_send", value: "0" %>
    <%= form.button "Preview", type: "submit", name: "intent", value: "preview", class: "btn-primary" %>
    <%= form.button "Send", type: "submit", name: "intent", value: "send", class: "btn-primary" %>
    <%= form.button "Save draft", type: "submit", name: "intent", value: "save", class: "border border-gray-300 rounded-lg px-5 py-2 text-gray-700 hover:bg-gray-50 transition" %>
    <%= link_to "Cancel", newsletter_signup_path, class: "text-brand-blue-600 hover:text-brand-red-600 transition px-4 py-2" %>
  </div>
<% end %>
