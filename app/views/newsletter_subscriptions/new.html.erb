<div class="container-wide py-8" data-controller="newsletter-subscribe" data-newsletter-subscribe-auto-open-value="<%= @newsletter_subscription.errors.any? || flash[:alert].present? %>">
  <header class="mb-8 flex flex-wrap items-start justify-between gap-5">
    <div>
      <h1 class="text-3xl font-bold">Newsletter</h1>
      <p class="mt-1 text-gray-600">Read the latest updates or subscribe to receive future newsletters by email.</p>
    </div>
    <div class="flex flex-col items-end gap-2">
      <% if current_user&.can_create? %>
        <%= link_to "Create newsletter", new_newsletter_path, class: "btn-primary" %>
      <% end %>
      <button type="button"
              class="btn-primary bg-brand-blue-600 hover:bg-brand-blue-700"
              data-action="newsletter-subscribe#open">
        Subscribe
      </button>
    </div>
  </header>

  <dialog class="w-[calc(100%-2rem)] max-w-lg rounded-lg border-0 p-0 shadow-xl backdrop:bg-black/50" data-newsletter-subscribe-target="dialog" data-action="click->newsletter-subscribe#closeOnBackdrop" aria-labelledby="newsletter-subscribe-title">
    <div class="bg-white p-6 md:p-8">
      <div class="mb-5 flex items-start justify-between gap-4">
        <div>
          <h2 id="newsletter-subscribe-title" class="text-2xl font-bold">Subscribe to the newsletter</h2>
          <p class="mt-1 text-gray-600">Receive EGC updates by email. You can unsubscribe at any time.</p>
        </div>
        <button type="button" class="rounded p-2 text-gray-500 hover:bg-gray-100" aria-label="Close subscribe form" data-action="newsletter-subscribe#close">✕</button>
      </div>

      <% if @newsletter_subscription.errors.any? %>
        <div class="mb-4 rounded-lg border border-red-200 bg-red-50 p-4" role="alert">
          <h3 class="mb-2 font-semibold text-red-800">There were errors with your submission:</h3>
          <ul class="list-inside list-disc text-red-700">
            <% @newsletter_subscription.errors.full_messages.each do |message| %>
              <li><%= message %></li>
            <% end %>
          </ul>
        </div>
      <% end %>

      <%= form_with model: @newsletter_subscription, url: newsletter_subscriptions_path, class: "space-y-4" do |form| %>
        <div>
          <%= form.label :email, "Email *", class: "mb-2 block text-sm font-medium text-gray-700" %>
          <%= form.email_field :email, class: "w-full rounded-lg border border-gray-300 px-4 py-2 focus:border-brand-blue-600 focus:ring-brand-blue-600", autocomplete: "email", required: true, autofocus: true %>
        </div>
        <%= render "shared/turnstile_widget" %>
        <div class="flex flex-wrap gap-3 pt-2">
          <%= form.submit "Subscribe", class: "btn-primary" %>
          <button type="button" class="border border-gray-300 rounded-lg px-5 py-2 text-gray-700 hover:bg-gray-50 transition" data-action="newsletter-subscribe#close">Cancel</button>
        </div>
      <% end %>
    </div>
  </dialog>

  <% if @drafts.present? %>
    <section class="mb-10">
      <h2 class="mb-3 text-xl font-semibold">Drafts</h2>
      <div class="overflow-x-auto rounded-lg border border-gray-200 bg-white">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-gray-50"><tr><th class="px-5 py-3 text-left text-sm font-semibold">Title</th><th class="px-5 py-3 text-left text-sm font-semibold">Last updated</th><th class="px-5 py-3"></th></tr></thead>
          <tbody class="divide-y divide-gray-200">
            <% @drafts.each do |draft| %>
              <tr>
                <td class="px-5 py-3"><%= draft.title %></td>
                <td class="px-5 py-3"><%= eu_datetime(draft.updated_at, twelve_hour: true) %></td>
                <td class="px-5 py-3 text-right"><%= link_to "Edit", edit_newsletter_path(draft), class: "text-brand-blue-600 hover:text-brand-red-600" %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </section>
  <% end %>

  <section aria-labelledby="sent-newsletters-heading" class="space-y-4">
    <h2 id="sent-newsletters-heading" class="text-xl font-semibold">Sent newsletters</h2>
    <% @newsletters.each do |newsletter| %>
      <%= link_to newsletter_path(newsletter), class: "block rounded-lg focus:outline-none focus:ring-2 focus:ring-brand-blue-500" do %>
        <article class="rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:border-brand-blue-300 hover:shadow-md">
          <h3 class="text-xl font-semibold hover:text-brand-red-600"><%= newsletter.title %></h3>
          <p class="mt-1 text-sm text-gray-500">Sent <%= eu_datetime(newsletter.sent_at, twelve_hour: true) %></p>
          <span class="sr-only">Read newsletter</span>
        </article>
      <% end %>
    <% end %>
    <% if @newsletters.empty? %>
      <p class="py-12 text-center text-gray-500">No newsletters have been sent yet.</p>
    <% end %>
  </section>
</div>
