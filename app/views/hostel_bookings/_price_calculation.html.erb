<%# Shows the price of a hostel booking as quantity × nights × price per item, summing to the total. %>
<% euros = ->(cents) { "€ #{format('%.2f', cents / 100.0)}" } %>
<table class="w-full text-sm mb-6">
  <caption class="sr-only">Price calculation</caption>
  <tbody class="divide-y divide-gray-100">
    <% hostel_booking.price_lines.each do |line| %>
      <tr>
        <td class="py-2 pr-4 text-neutral-900">
          <%= line.quantity %> × <%= line.label %> × <%= pluralize(line.nights, "night") %> × <%= euros.call(line.unit_price_cents) %>
        </td>
        <td class="py-2 text-right text-neutral-900 whitespace-nowrap"><%= euros.call(line.subtotal_cents) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr class="border-t-2 border-neutral-300">
      <th scope="row" class="py-2 pr-4 text-left font-semibold text-brand-blue-900">Total</th>
      <td class="py-2 text-right font-bold text-brand-blue-900 whitespace-nowrap"><%= hostel_booking.amount_formatted %></td>
    </tr>
  </tfoot>
</table>
