<% order = booking.order %>
<div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
  <h2 class="text-xl font-semibold mb-6 text-brand-blue-900">Order and payment</h2>
  <dl class="space-y-3 text-sm">
    <div class="flex justify-between gap-4"><dt>Payment status</dt><dd><%= render "hostel_bookings/status", booking: booking %></dd></div>
    <% if order %>
      <div class="flex justify-between gap-4"><dt>Order</dt><dd><%= link_to "Order ##{order.id}", (admin ? admin_order_path(order) : (order.draft? ? order_path : submitted_order_path(order))), class: "text-brand-blue-700 underline" %></dd></div>
      <div class="flex justify-between gap-4"><dt>Order status</dt><dd><%= order.cancelled? ? "Order canceled" : "Active" %></dd></div>
    <% end %>
  </dl>
  <% if related_tickets.any? %>
    <h3 class="font-semibold mt-6 mb-2">Participants in this order</h3>
    <ul class="space-y-1 text-sm">
      <% related_tickets.each do |ticket| %>
        <% participant = ticket.participant %>
        <li><%= link_to "#{participant.first_name} #{participant.last_name}", (admin ? admin_participant_path(participant) : participant_path(participant)), class: "text-brand-blue-700 underline" %></li>
      <% end %>
    </ul>
  <% end %>
</div>
