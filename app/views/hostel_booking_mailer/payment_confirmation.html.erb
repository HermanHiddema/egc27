<p>Hello <%= @user.display_name %>,</p>

<p>We have received your payment for your hostel bookings at the European Go Congress 2027. Thank you!</p>

<% @hostel_bookings.each do |booking| %>
  <p>
    <strong>Arrival:</strong> <%= booking.arrival_date.strftime("%A %-d %B %Y") %><br>
    <strong>Departure:</strong> <%= booking.departure_date.strftime("%A %-d %B %Y") %><br>
    <strong>Nights:</strong> <%= booking.nights %>
  </p>

  <p>
    <% booking.price_lines.each do |line| %>
      <%= line.quantity %> × <%= line.label %> × <%= pluralize(line.nights, "night") %> × € <%= format("%.2f", line.unit_price_cents / 100.0) %> = € <%= format("%.2f", line.subtotal_cents / 100.0) %><br>
    <% end %>
  </p>

  <p><%= link_to "View your hostel booking", hostel_booking_url(booking) %></p>
<% end %>

<p><strong>Total paid for this order:</strong> <%= @payment.amount_formatted %></p>

<p>
  If you have any questions, please contact us at
  <%= mail_to "info@egc2027.nl" %>.
</p>
