<p>Hello <%= @payment.order.user.display_name %>,</p>

<p>We have received your payment for the European Go Congress 2027. Thank you!</p>

<p>
  <% @participants.each do |participant| %>
    <strong>Congress Pass:</strong> <%= participant.first_name %> <%= participant.last_name %><br>
  <% end %>
  <% @hostel_bookings.each do |booking| %>
    <strong>Hostel booking:</strong> <%= booking.description %><br>
  <% end %>
  <strong>Order details:</strong> <%= @payment.description %><br>
  <strong>Amount paid:</strong> <%= @payment.amount_formatted %>
</p>

<p>Your order is now complete.</p>

<% @participants.each do |participant| %>
  <p><%= link_to "View registration for #{participant.first_name} #{participant.last_name}", participant_url(participant) %></p>
<% end %>

<p>
  If you have any questions, please contact us at
  <%= mail_to "info@egc2027.nl" %>.
</p>
