<div class="container-wide py-12">
  <div class="flex justify-between items-center mb-8">
    <div>
      <h1 class="text-4xl font-bold">Our Sponsors</h1>
      <p class="text-gray-600 mt-2">The organisations that make this event possible.</p>
    </div>
    <% if current_user&.can_delete? %>
      <%= link_to "New Sponsor", new_sponsor_path, class: "btn-primary" %>
    <% end %>
  </div>

  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 gap-5">
    <% @sponsors.each do |sponsor| %>
      <article class="group relative flex min-h-80 flex-col overflow-hidden rounded-xl border border-gray-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-lg">
        <% if sponsor.website.present? %>
          <%= link_to sponsor.website, target: "_blank", rel: "noopener noreferrer", class: "absolute inset-0 z-0 rounded-xl focus:outline-none focus-visible:ring-4 focus-visible:ring-brand-blue-500", aria: { label: "Visit #{sponsor.name} website" } do %>
            <span class="sr-only">Visit #{sponsor.name}</span>
          <% end %>
        <% end %>

        <div class="relative z-10 flex h-40 items-center justify-center border-b border-gray-100 bg-white p-6 pointer-events-none">
          <% if sponsor.logo.attached? %>
            <% logo_source = main_image_representation(sponsor.logo, resize_to_limit: [512, 512]) || sponsor.logo %>
            <%= image_tag logo_source, alt: "#{sponsor.name} logo", class: "max-h-full max-w-full object-contain", loading: "lazy", decoding: "async" %>
          <% else %>
            <span class="text-2xl font-bold text-gray-700"><%= sponsor.name %></span>
          <% end %>
        </div>

        <div class="relative z-10 flex flex-1 flex-col p-5 pointer-events-none">
          <h2 class="text-xl font-bold text-gray-900 group-hover:text-brand-blue-700"><%= sponsor.name %></h2>
          <% if sponsor.description.present? %>
            <p class="mt-2 flex-1 text-sm leading-6 text-gray-600 whitespace-pre-line"><%= sponsor.description %></p>
          <% end %>

          <% if sponsor.social_media_links.values.any?(&:present?) %>
            <div class="mt-5 flex items-center gap-3">
              <% sponsor.social_media_links.each do |platform, url| %>
                <% next if url.blank? %>
                <% platform_label = Sponsor::SOCIAL_MEDIA_PLATFORMS[platform.to_s] || platform.to_s.capitalize %>
                <% icon = sponsor_social_media_icon(platform, css_class: "w-5 h-5") %>
                <%= link_to url, target: "_blank", rel: "noopener noreferrer", class: "relative z-20 pointer-events-auto inline-flex h-10 w-10 items-center justify-center rounded-full bg-gray-100 text-gray-600 transition hover:bg-brand-blue-600 hover:text-white focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-blue-500", aria: { label: "#{sponsor.name} on #{platform_label}" } do %>
                  <%= icon || platform_label %>
                <% end %>
              <% end %>
            </div>
          <% end %>

          <% if current_user&.can_delete? %>
            <div class="relative z-20 pointer-events-auto flex gap-4 mt-4 border-t border-gray-100 pt-3">
              <%= link_to "Edit", edit_sponsor_path(sponsor), class: "text-brand-blue-600 hover:text-brand-red-600 transition" %>
              <%= button_to "Delete", sponsor_path(sponsor), method: :delete, data: { turbo_confirm: "Are you sure you want to delete this sponsor?" }, class: "text-brand-red-600 hover:text-brand-red-700 transition" %>
            </div>
          <% end %>
        </div>
      </article>
    <% end %>

    <% if @sponsors.empty? %>
      <div class="text-center text-gray-500 py-12">
        <p class="text-xl">No sponsors yet.</p>
      </div>
    <% end %>
  </div>
</div>
