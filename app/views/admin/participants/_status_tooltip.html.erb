<span class="inline-block normal-case tracking-normal" data-controller="status-tooltip" data-action="mouseenter->status-tooltip#showOnHover mouseleave->status-tooltip#scheduleClose">
  <button type="button" class="inline-flex h-5 w-5 items-center justify-center rounded-full border border-neutral-500 text-xs" aria-label="About <%= title %>" aria-expanded="false" popovertarget="<%= id %>" aria-controls="<%= id %>" aria-describedby="<%= id %>" data-status-tooltip-target="button" data-action="click->status-tooltip#toggle">i</button>
  <span id="<%= id %>" popover="auto" role="tooltip" data-status-tooltip-target="popup" data-action="toggle->status-tooltip#sync mouseenter->status-tooltip#cancelClose mouseleave->status-tooltip#scheduleClose" class="m-0 max-h-[calc(100vh-1rem)] w-80 max-w-[80vw] overflow-y-auto rounded-md border border-neutral-200 bg-white p-4 text-left text-sm font-normal text-neutral-800 shadow-lg">
    <% paragraphs.each do |paragraph| %><span class="mb-2 block last:mb-0"><%= paragraph %></span><% end %>
  </span>
</span>
