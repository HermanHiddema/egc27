<div class="container-wide py-12">
  <div class="max-w-3xl mx-auto">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-4xl font-bold">Edit Participant</h1>
      <%= link_to "Back to list", admin_participants_path, class: "text-brand-red-600 hover:text-brand-red-700 transition" %>
    </div>

    <% if @participant.player? %>
      <% latest_payment = @participant.payments.order(created_at: :desc).first %>
      <% if latest_payment&.manual? && !latest_payment.unsuccessful? %>
        <div class="mb-6">
          <%= link_to "Edit payment", edit_admin_participant_payment_path(@participant, latest_payment), class: "text-brand-red-600 hover:text-brand-red-700 transition" %>
        </div>
      <% elsif !@participant.blocking_payments? %>
        <div class="mb-6">
          <%= link_to "Record payment", new_admin_participant_payment_path(@participant), class: "text-brand-red-600 hover:text-brand-red-700 transition" %>
        </div>
      <% end %>
    <% end %>

    <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
      <%= render "form", participant: @participant %>
    </div>

    <div class="mt-8 bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
      <h2 class="text-2xl font-bold mb-4">Delete participant</h2>

      <% if @participant.deletable? %>
        <% last_participant = @participant.only_participant_for_user? %>
        <% confirm_message = if last_participant
             "Are you sure you want to delete this participant? The user account is deleted as well when the box is checked. This cannot be undone."
           else
             "Are you sure you want to delete this participant? This cannot be undone."
           end %>
        <%= form_with url: admin_participant_path(@participant), method: :delete, data: { turbo_confirm: confirm_message } do %>
          <% if last_participant %>
            <p class="text-sm text-neutral-700 mb-3">
              This is the last participant registered by <strong><%= @participant.user.email %></strong>.
              Deleting it leaves an account without any registrations.
            </p>
            <label class="flex items-center gap-2 text-sm text-neutral-900 mb-4">
              <%= check_box_tag :delete_user, "1", false, class: "rounded border-neutral-300" %>
              Also delete the user account
            </label>
          <% else %>
            <p class="text-sm text-neutral-700 mb-4">This permanently removes the participant and their registration data.</p>
          <% end %>
          <%= submit_tag "Delete participant", class: "btn-primary", data: { turbo_submits_with: "Deleting…" } %>
        <% end %>
      <% else %>
        <p class="text-sm text-neutral-700">This participant has a successful payment and cannot be deleted.</p>
      <% end %>
    </div>
  </div>
</div>
