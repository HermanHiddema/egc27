<div class="container-wide py-12" data-controller="country-names">
  <div class="flex justify-between items-center mb-8">
    <h1 class="text-4xl font-bold">Participants (Admin)</h1>
    <div class="flex items-center gap-4">
      <%= button_to "Sync EGD data", sync_egd_admin_participants_path, method: :post, class: "btn-primary" %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-4 shadow-sm mb-4">
    <div class="flex flex-wrap items-end justify-between gap-4">
      <%= form_with url: admin_participants_path, method: :get, local: true, class: "flex flex-wrap items-end gap-3", data: { controller: "auto-submit", action: "submit->auto-submit#preserveNameFocus" } do %>
      <div>
        <label for="country" class="block text-xs font-semibold uppercase tracking-wide text-neutral-700 mb-1">Country</label>
        <%= select_tag :country, options_for_select([["All countries", ""]] + @countries.map { |country| [country, country] }, @country_filter), class: "w-full rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-900", data: { country_names_target: "select", action: "change->country-names#filter" } %>
      </div>
      <div>
        <label for="type" class="block text-xs font-semibold uppercase tracking-wide text-neutral-700 mb-1">Type</label>
        <%= select_tag :type, options_for_select([["All types", ""], ["Player", "player"], ["Visitor", "visitor"]], @type_filter), class: "w-full rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-900", data: { action: "change->auto-submit#submit" } %>
      </div>
      <div>
        <label for="status" class="block text-xs font-semibold uppercase tracking-wide text-neutral-700 mb-1">Status</label>
        <%= select_tag :status, options_for_select([["All statuses", ""], ["Pending", "pending"], ["Confirmed", "confirmed"], ["Paid", "paid"], ["Chargeback", "charged_back"], ["Refund", "refunded"]], @status_filter), class: "w-full rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-900", data: { action: "change->auto-submit#submit" } %>
      </div>
      <div>
        <label for="name" class="block text-xs font-semibold uppercase tracking-wide text-neutral-700 mb-1">Name</label>
        <%= search_field_tag :name, @name_filter, placeholder: "Filter by name", class: "w-full rounded-md border border-neutral-300 bg-white px-3 py-2 text-sm text-neutral-900", data: { auto_submit_target: "name", action: "input->auto-submit#submitAfterDelay" } %>
      </div>
      <%= hidden_field_tag :sort, @sort %>
      <%= hidden_field_tag :direction, @direction %>
      <noscript><%= submit_tag "Filter", class: "btn-primary" %></noscript>
      <% end %>

      <% participant_count = @participants.length %>
      <p id="participant-count" class="text-sm text-neutral-700"><strong><%= participant_count %></strong> participant<%= "s" unless participant_count == 1 %></p>
    </div>
  </div>

  <% if @participants.any? %>
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-neutral-50">
            <tr>
              <% filters = { country: @country_filter, status: @status_filter, type: @type_filter, name: @name_filter.presence } %>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">
                <%= link_to "Number #{sort_indicator("number", @sort, @direction)}".strip, admin_participants_path(**filters, sort: "number", direction: next_sort_direction("number", @sort, @direction)), class: "hover:text-brand-red-700 transition" %>
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">
                <%= link_to "Name #{sort_indicator("name", @sort, @direction)}".strip, admin_participants_path(**filters, sort: "name", direction: next_sort_direction("name", @sort, @direction)), class: "hover:text-brand-red-700 transition" %>
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">
                <%= link_to "Email #{sort_indicator("email", @sort, @direction)}".strip, admin_participants_path(**filters, sort: "email", direction: next_sort_direction("email", @sort, @direction)), class: "hover:text-brand-red-700 transition" %>
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">
                <%= link_to "Country #{sort_indicator("country", @sort, @direction)}".strip, admin_participants_path(**filters, sort: "country", direction: next_sort_direction("country", @sort, @direction)), class: "hover:text-brand-red-700 transition" %>
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">
                <% strength_direction = @sort == "rank" ? next_sort_direction("rank", @sort, @direction) : :desc %>
                <%= link_to "Strength #{sort_indicator("rank", @sort, @direction)}".strip, admin_participants_path(**filters, sort: "rank", direction: strength_direction), class: "hover:text-brand-red-700 transition" %>
              </th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Type</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">
                <%= link_to "Status #{sort_indicator("status", @sort, @direction)}".strip, admin_participants_path(**filters, sort: "status", direction: next_sort_direction("status", @sort, @direction)), class: "hover:text-brand-red-700 transition" %>
              </th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">Actions</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <% @participants.each do |participant| %>
              <tr>
                <td class="px-4 py-3 text-sm font-medium text-neutral-900"><%= participant.participant_number %></td>
                <td class="px-4 py-3 text-sm text-neutral-900"><%= [participant.first_name, participant.last_name].join(" ") %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= participant.email %></td>
                <td class="px-4 py-3 text-sm text-neutral-700" data-country-names-target="code" data-country-code="<%= participant.country %>"><%= country_with_flag(participant.country) %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= participant.rank_grade.presence || "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= participant.participant_type&.capitalize %></td>
                <td class="px-4 py-3 text-sm">
                  <% status = participant.registration_status %>
                  <span class="inline-flex items-center rounded-full px-2.5 py-0.5 text-xs font-medium <%= participant_status_badge_class(status) %>"><%= status %></span>
                </td>
                <td class="px-4 py-3 text-sm text-right">
                  <%= link_to "Edit", edit_admin_participant_path(participant), class: "text-brand-red-600 hover:text-brand-red-700 transition" %>
                  <% if participant.player? %>
                    <% latest_payment = @latest_payments_by_participant_id[participant.id] %>
                    <% if latest_payment&.manual? && !latest_payment.unsuccessful? %>
                      <%= link_to "Edit payment", edit_admin_participant_payment_path(participant, latest_payment), class: "ml-3 text-brand-red-600 hover:text-brand-red-700 transition" %>
                    <% elsif !participant.blocking_payments? %>
                      <%= link_to "Add payment", new_admin_participant_payment_path(participant), class: "ml-3 text-brand-red-600 hover:text-brand-red-700 transition" %>
                    <% end %>
                  <% end %>
                </td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
      <p class="text-neutral-700">No participants match the selected filters.</p>
    </div>
  <% end %>
</div>
