<div class="container-wide py-12">
  <div class="flex flex-wrap justify-between items-center gap-4 mb-8">
    <h1 class="text-4xl font-bold">Settlements (Admin)</h1>
    <div class="flex items-center gap-4">
      <%= link_to "Payments", admin_payments_path, class: "text-brand-blue-600 hover:text-brand-red-600 transition" %>
      <% if @configured %>
        <%= button_to "Sync with Mollie", sync_admin_settlements_path, method: :post, class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <% unless @configured %>
    <div class="bg-yellow-50 border border-yellow-200 rounded-lg p-4 mb-4 text-sm text-yellow-800">
      Settlements cannot be synced with Mollie because no Mollie organization access token is configured.
      Create an organization access token with the <code>settlements.read</code> and <code>payments.read</code>
      permissions and set it as <code>mollie_organization_token</code> in the credentials or as the
      <code>MOLLIE_ORGANIZATION_TOKEN</code> environment variable.
    </div>
  <% end %>

  <p class="text-sm text-neutral-700 mb-4">
    Mollie pays out the payments received in a period in a settlement, minus its fees. Refunds and chargebacks
    in the same period are deducted as well. Only settlements created on or after the date of the first Mollie
    payment are synced; set the <code>MOLLIE_SETTLEMENT_BALANCE_ID</code> environment variable to only sync the
    settlements of a single balance.
  </p>

  <% if @settlements.any? %>
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-neutral-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Settled</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Reference</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Status</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">Payments</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">Payments total</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">Deductions</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">Paid out</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <% @settlements.each do |settlement| %>
              <tr>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= settlement.settled_at&.strftime("%-d %b %Y") || "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-900">
                  <%= link_to settlement.reference.presence || settlement.mollie_settlement_id, admin_settlement_path(settlement), class: "text-brand-blue-600 hover:text-brand-red-600 transition" %>
                </td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= settlement.status_label %></td>
                <td class="px-4 py-3 text-sm text-neutral-700 text-right"><%= settlement.payments.size %></td>
                <td class="px-4 py-3 text-sm text-neutral-700 text-right"><%= Settlement.format_cents(settlement.payments_total_cents) %></td>
                <td class="px-4 py-3 text-sm text-neutral-700 text-right"><%= settlement.deductions_cents ? Settlement.format_cents(settlement.deductions_cents) : "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-900 text-right"><%= settlement.amount_formatted %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
      <p class="text-neutral-700">No settlements have been synced from Mollie yet.</p>
    </div>
  <% end %>
</div>
