<div class="container-wide py-12">
  <div class="flex flex-wrap justify-between items-center gap-4 mb-8">
    <h1 class="text-4xl font-bold">Settlement <%= @settlement.reference.presence || @settlement.mollie_settlement_id %></h1>
    <div class="flex items-center gap-4">
      <%= link_to "All settlements", admin_settlements_path, class: "text-brand-blue-600 hover:text-brand-red-600 transition" %>
      <% if @configured %>
        <%= button_to "Resync with Mollie", resync_admin_settlement_path(@settlement), method: :post, class: "btn-primary" %>
      <% end %>
    </div>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm mb-4">
    <dl class="grid grid-cols-2 md:grid-cols-4 gap-4 text-sm">
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-700">Status</dt>
        <dd class="text-neutral-900"><%= @settlement.status_label %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-700">Settled</dt>
        <dd class="text-neutral-900"><%= @settlement.settled_at&.strftime("%-d %b %Y") || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-700">Mollie ID</dt>
        <dd class="text-neutral-900"><%= @settlement.mollie_settlement_id %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-700">Mollie Balance ID</dt>
        <dd class="text-neutral-900"><%= @settlement.mollie_balance_id.presence || "—" %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-700">Payments total</dt>
        <dd class="text-neutral-900"><%= Settlement.format_cents(@settlement.payments_total_cents) %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-700">Other webshop payments total</dt>
        <dd class="text-neutral-900"><%= Settlement.format_cents(@settlement.other_payments_total_cents) %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-700">Deductions</dt>
        <dd class="text-neutral-900"><%= @settlement.deductions_cents ? Settlement.format_cents(@settlement.deductions_cents) : "—" %></dd>
      </div>
      <div>
        <dt class="text-xs font-semibold uppercase tracking-wide text-neutral-700">Paid out</dt>
        <dd class="text-neutral-900"><%= @settlement.amount_formatted %></dd>
      </div>
    </dl>
  </div>

  <% periods = @settlement.breakdown_periods %>
  <h2 class="text-2xl font-bold mt-8 mb-4">Breakdown</h2>
  <% if periods.any? %>
    <% periods.each do |period| %>
      <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden mb-4">
        <div class="px-4 py-3 border-b border-gray-200 flex flex-wrap justify-between gap-2">
          <h3 class="font-semibold"><%= period.label %></h3>
          <% if period.invoice_id %>
            <span class="text-sm text-neutral-700">Invoice <%= period.invoice_id %></span>
          <% end %>
        </div>
        <div class="overflow-x-auto">
          <table class="min-w-full divide-y divide-gray-200">
            <thead class="bg-neutral-50">
              <tr>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Type</th>
                <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Description</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">Count</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">Net</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">VAT</th>
                <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">Gross</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-gray-100 bg-white">
              <% [["Revenue", period.revenue], ["Costs", period.costs]].each do |type, lines| %>
                <% lines.each do |line| %>
                  <tr>
                    <td class="px-4 py-3 text-sm text-neutral-700"><%= type %></td>
                    <td class="px-4 py-3 text-sm text-neutral-900"><%= line.description %></td>
                    <td class="px-4 py-3 text-sm text-neutral-700 text-right"><%= line.count || "—" %></td>
                    <td class="px-4 py-3 text-sm text-neutral-700 text-right"><%= line.net_cents ? Settlement.format_cents(line.net_cents) : "—" %></td>
                    <td class="px-4 py-3 text-sm text-neutral-700 text-right"><%= line.vat_cents ? Settlement.format_cents(line.vat_cents) : "—" %></td>
                    <td class="px-4 py-3 text-sm text-neutral-900 text-right"><%= line.gross_cents ? Settlement.format_cents(line.gross_cents) : "—" %></td>
                  </tr>
                <% end %>
              <% end %>
            </tbody>
            <tfoot class="bg-neutral-50 text-sm">
              <tr>
                <td class="px-4 py-2 font-semibold" colspan="5">Total revenue</td>
                <td class="px-4 py-2 font-semibold text-right"><%= Settlement.format_cents(period.revenue_cents) %></td>
              </tr>
              <tr>
                <td class="px-4 py-2 font-semibold" colspan="5">Total costs</td>
                <td class="px-4 py-2 font-semibold text-right"><%= Settlement.format_cents(period.costs_cents) %></td>
              </tr>
            </tfoot>
          </table>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm mb-4">
      <p class="text-neutral-700">No breakdown of this settlement has been fetched from Mollie yet.</p>
    </div>
  <% end %>

  <h2 class="text-2xl font-bold mt-8 mb-4">Refunds</h2>
  <% if @refunds.any? %>
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden mb-4">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-neutral-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Date</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Participant</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Payment</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Description</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Mollie ID</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">Amount</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">Deducted</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <% @refunds.each do |item| %>
              <% payment = item.payment %>
              <tr>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= item.mollie_created_at&.strftime("%-d %b %Y") || "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-900">
                  <% if payment %>
                    <%= [payment.participant.first_name, payment.participant.last_name].join(" ") %>
                    <span class="text-neutral-500">(<%= payment.participant.participant_number %>)</span>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= item.mollie_payment_id.presence || "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= item.description.presence || "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= item.mollie_refund_id %></td>
                <td class="px-4 py-3 text-sm text-neutral-700 text-right"><%= item.amount_cents ? Settlement.format_cents(item.amount_cents) : "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-900 text-right"><%= item.settlement_amount_cents ? Settlement.format_cents(item.settlement_amount_cents) : "—" %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-neutral-50 text-sm">
            <tr>
              <td class="px-4 py-2 font-semibold" colspan="6">Total deducted</td>
              <td class="px-4 py-2 font-semibold text-right"><%= Settlement.format_cents(@settlement.refunds_total_cents) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm mb-4">
      <p class="text-neutral-700">No refunds were deducted from this settlement.</p>
    </div>
  <% end %>

  <h2 class="text-2xl font-bold mt-8 mb-4">Chargebacks</h2>
  <% if @chargebacks.any? %>
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden mb-4">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-neutral-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Date</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Participant</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Payment</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Reversed</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Mollie ID</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">Amount</th>
              <th class="px-4 py-3 text-right text-xs font-semibold uppercase tracking-wide text-neutral-700">Deducted</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <% @chargebacks.each do |item| %>
              <% payment = item.payment %>
              <tr>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= item.mollie_created_at&.strftime("%-d %b %Y") || "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-900">
                  <% if payment %>
                    <%= [payment.participant.first_name, payment.participant.last_name].join(" ") %>
                    <span class="text-neutral-500">(<%= payment.participant.participant_number %>)</span>
                  <% else %>
                    —
                  <% end %>
                </td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= item.mollie_payment_id.presence || "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= item.reversed? ? "Yes" : "No" %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= item.mollie_chargeback_id %></td>
                <td class="px-4 py-3 text-sm text-neutral-700 text-right"><%= item.amount_cents ? Settlement.format_cents(item.amount_cents) : "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-900 text-right"><%= item.settlement_amount_cents ? Settlement.format_cents(item.settlement_amount_cents) : "—" %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-neutral-50 text-sm">
            <tr>
              <td class="px-4 py-2 font-semibold" colspan="6">Total deducted</td>
              <td class="px-4 py-2 font-semibold text-right"><%= Settlement.format_cents(@settlement.chargebacks_total_cents) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm mb-4">
      <p class="text-neutral-700">No chargebacks were deducted from this settlement.</p>
    </div>
  <% end %>

  <h2 class="text-2xl font-bold mt-8 mb-4">Payments</h2>

  <% if @payments.any? %>
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-neutral-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Date</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Participant</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Amount</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Description</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Method</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Mollie ID</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <% @payments.each do |payment| %>
              <tr>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= payment.created_at.strftime("%-d %b %Y") %></td>
                <td class="px-4 py-3 text-sm text-neutral-900">
                  <%= [payment.participant.first_name, payment.participant.last_name].join(" ") %>
                  <span class="text-neutral-500">(<%= payment.participant.participant_number %>)</span>
                </td>
                <td class="px-4 py-3 text-sm text-neutral-900"><%= payment.amount_formatted %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= payment.description %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= payment.payment_method_label || "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= payment.mollie_payment_id %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= payment.status.humanize %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    </div>
  <% else %>
    <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
      <p class="text-neutral-700">No payments known here were paid out in this settlement.</p>
    </div>
  <% end %>

  <% if @settlement.other_payments.any? %>
    <h2 class="text-2xl font-bold mt-8 mb-4">Payments from other webshops</h2>
    <p class="text-sm text-neutral-700 mb-4">
      These payments were made on the same Mollie account by another webshop. They are not imported as payments here,
      but are needed to account for the payout.
    </p>
    <div class="bg-white border border-gray-200 rounded-lg shadow-sm overflow-hidden">
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-neutral-50">
            <tr>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Date</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Amount</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Description</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Method</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Mollie ID</th>
              <th class="px-4 py-3 text-left text-xs font-semibold uppercase tracking-wide text-neutral-700">Status</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100 bg-white">
            <% @settlement.other_payments.each do |payment| %>
              <tr>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= Settlement.parse_time(payment["created_at"])&.strftime("%-d %b %Y") || "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-900"><%= payment["amount_cents"] ? Settlement.format_cents(payment["amount_cents"]) : "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= payment["description"].presence || "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= payment["method"].presence&.humanize || "—" %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= payment["id"] %></td>
                <td class="px-4 py-3 text-sm text-neutral-700"><%= payment["status"].presence&.humanize || "—" %></td>
              </tr>
            <% end %>
          </tbody>
          <tfoot class="bg-neutral-50 text-sm">
            <tr>
              <td class="px-4 py-2 font-semibold">Total</td>
              <td class="px-4 py-2 font-semibold" colspan="5"><%= Settlement.format_cents(@settlement.other_payments_total_cents) %></td>
            </tr>
          </tfoot>
        </table>
      </div>
    </div>
  <% end %>
</div>
