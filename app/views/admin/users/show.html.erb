<div class="container-wide py-12">
  <div class="mb-6">
    <%= link_to "← Back to Users", users_path, class: "text-brand-blue-600 hover:text-brand-red-600 transition" %>
  </div>

  <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
    <h1 class="text-3xl font-bold mb-6"><%= @user.display_name %></h1>
    <dl class="grid gap-4 sm:grid-cols-2">
      <div>
        <dt class="text-sm font-semibold text-neutral-600">Email</dt>
        <dd class="break-all text-neutral-900"><%= @user.email %></dd>
      </div>
      <div>
        <dt class="text-sm font-semibold text-neutral-600">Role</dt>
        <dd class="text-neutral-900"><%= @user.role.humanize %></dd>
      </div>
      <div>
        <dt class="text-sm font-semibold text-neutral-600">Orders</dt>
        <dd class="text-neutral-900"><%= @user.orders.size %></dd>
      </div>
      <div>
        <dt class="text-sm font-semibold text-neutral-600">Participants</dt>
        <dd class="text-neutral-900"><%= @user.participants.size %></dd>
      </div>
      <div>
        <dt class="text-sm font-semibold text-neutral-600">Hostel bookings</dt>
        <dd class="text-neutral-900"><%= @user.hostel_bookings.size %></dd>
      </div>
    </dl>
  </div>
</div>
