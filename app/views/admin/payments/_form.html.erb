<%= form_with model: payment, url: url, method: method, html: { autocomplete: "off" } do |form| %>
  <%= hidden_field_tag :confirmed_total_cents, @order.total_cents if @order %>
  <% if payment.errors.any? %>
    <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
      <h2 class="text-red-800 font-semibold mb-2">There were errors with this submission:</h2>
      <ul class="text-red-700 list-disc list-inside">
        <% payment.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
    <div>
      <% if local_assigns[:fixed_order_amount] %>
        <span class="block text-sm font-medium text-gray-700 mb-2">Full Order amount</span>
        <p class="rounded-lg border border-gray-200 bg-gray-50 px-4 py-2 text-gray-900"><%= Settlement.format_cents(@order.total_cents) %></p>
      <% else %>
        <%= form.label :amount_eur, "Full Order amount (EUR) *", class: "block text-sm font-medium text-gray-700 mb-2" %>
        <%= form.text_field :amount_eur, value: amount_eur_input.presence || format("%.2f", payment.amount_cents.to_i / 100.0), inputmode: "decimal", class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-brand-blue-600 focus:border-brand-blue-600" %>
      <% end %>
    </div>

    <div>
      <%= form.label :payment_method, "Payment method *", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.select :payment_method, options_for_select(Payment::MANUAL_PAYMENT_METHODS.map { |manual_method| [Payment.payment_method_label(manual_method), manual_method] }, payment.payment_method), {}, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-brand-blue-600 focus:border-brand-blue-600" %>
    </div>

    <div>
      <%= form.label :payment_date, "Payment date *", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= render "shared/european_date_field", form: form, field: :payment_date %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :description, "Description *", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :description, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-brand-blue-600 focus:border-brand-blue-600" %>
    </div>

    <div class="md:col-span-2">
      <%= form.label :reference, "Reference", class: "block text-sm font-medium text-gray-700 mb-2" %>
      <%= form.text_field :reference, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-brand-blue-600 focus:border-brand-blue-600", placeholder: "Bank transaction reference, receipt number, …" %>
    </div>


  </div>

  <div class="flex gap-4 mt-6">
    <%= form.submit submit_label, class: "btn-primary" %>
    <%= link_to "Cancel", (local_assigns[:cancel_path] || admin_participants_path), class: "text-neutral-700 hover:text-neutral-900 transition self-center" %>
  </div>
<% end %>
