<div class="container-wide py-12">
  <div class="max-w-3xl mx-auto">
    <div class="flex justify-between items-center mb-8">
      <h1 class="text-4xl font-bold">Record Payment</h1>
      <%= link_to "Back to list", admin_participants_path, class: "text-brand-red-600 hover:text-brand-red-700 transition" %>
    </div>

    <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm">
      <p class="text-sm text-neutral-700 mb-6">
        Record a payment received outside of Mollie (for example cash or bank transfer) for
        <strong><%= "#{@participant.first_name} #{@participant.last_name}" %></strong>
        (<%= @participant.participant_number %>).
      </p>

      <%= form_with model: @payment, url: admin_participant_payments_path(@participant), method: :post, html: { autocomplete: "off" } do |form| %>
        <% if @payment.errors.any? %>
          <div class="bg-red-50 border border-red-200 rounded-lg p-4 mb-6">
            <h2 class="text-red-800 font-semibold mb-2">There were errors with this submission:</h2>
            <ul class="text-red-700 list-disc list-inside">
              <% @payment.errors.full_messages.each do |message| %>
                <li><%= message %></li>
              <% end %>
            </ul>
          </div>
        <% end %>

        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
          <div>
            <%= form.label :amount_eur, "Amount (EUR) *", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.number_field :amount_eur, value: format("%.2f", @payment.amount_cents.to_i / 100.0), step: "0.01", min: "0.01", class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-brand-blue-600 focus:border-brand-blue-600" %>
          </div>

          <div>
            <%= form.label :payment_method, "Payment method *", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.select :payment_method, options_for_select(Payment::MANUAL_PAYMENT_METHODS.map { |method| [method.humanize, method] }, @payment.payment_method), {}, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-brand-blue-600 focus:border-brand-blue-600" %>
          </div>

          <div class="md:col-span-2">
            <%= form.label :description, "Description *", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_field :description, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-brand-blue-600 focus:border-brand-blue-600" %>
          </div>

          <div class="md:col-span-2">
            <%= form.label :reference, "Reference", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.text_field :reference, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-brand-blue-600 focus:border-brand-blue-600", placeholder: "Bank transaction reference, receipt number, …" %>
          </div>

          <div>
            <%= form.label :status, "Status *", class: "block text-sm font-medium text-gray-700 mb-2" %>
            <%= form.select :status, options_for_select([["Paid", "paid"], ["Open", "open"]], @payment.status), {}, class: "w-full border border-gray-300 rounded-lg px-4 py-2 focus:ring-brand-blue-600 focus:border-brand-blue-600" %>
          </div>
        </div>

        <p class="mt-4 text-xs text-gray-500">
          Recording a paid payment sends the participant a payment confirmation email.
        </p>

        <div class="flex gap-4 mt-6">
          <%= form.submit "Record payment", class: "btn-primary" %>
          <%= link_to "Cancel", admin_participants_path, class: "text-neutral-700 hover:text-neutral-900 transition self-center" %>
        </div>
      <% end %>
    </div>

    <% if @participant.payments.any? %>
      <div class="bg-white border border-gray-200 rounded-lg p-8 shadow-sm mt-8">
        <h2 class="text-lg font-semibold text-neutral-900 mb-4">Existing payments</h2>
        <table class="min-w-full divide-y divide-gray-200 text-sm">
          <thead>
            <tr>
              <th class="px-3 py-2 text-left font-semibold text-neutral-700">Date</th>
              <th class="px-3 py-2 text-left font-semibold text-neutral-700">Amount</th>
              <th class="px-3 py-2 text-left font-semibold text-neutral-700">Method</th>
              <th class="px-3 py-2 text-left font-semibold text-neutral-700">Status</th>
              <th class="px-3 py-2 text-left font-semibold text-neutral-700">Reference</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-gray-100">
            <% @participant.payments.order(created_at: :desc).each do |payment| %>
              <tr>
                <td class="px-3 py-2 text-neutral-700"><%= payment.created_at.strftime("%-d %b %Y") %></td>
                <td class="px-3 py-2 text-neutral-900"><%= payment.amount_formatted %></td>
                <td class="px-3 py-2 text-neutral-700"><%= payment.payment_method_label %></td>
                <td class="px-3 py-2 text-neutral-700"><%= payment.status.capitalize %></td>
                <td class="px-3 py-2 text-neutral-700"><%= payment.reference.presence || payment.mollie_payment_id %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% end %>
  </div>
</div>
