<div class="container-wide py-12">
  <div class="flex justify-between items-center mb-8 gap-4"><h1 class="text-4xl font-bold">Hostel bookings (Admin)</h1><%= link_to "← Back to Admin", dashboard_path, class: "text-brand-blue-600 hover:text-brand-red-600" %></div>
  <%= form_with url: admin_hostel_bookings_path, method: :get, class: "flex flex-wrap gap-3 mb-6", data: { controller: "auto-submit" } do %>
    <%= hidden_field_tag :sort, @sort %><%= hidden_field_tag :direction, @direction %>
    <%= render "admin/participants/status_filter", title: "Payment status", name: "payment_status", selected: @payment_filters, options: [["Not paid", "not_paid"], ["Awaiting payment", "unpaid"]] + Payment::STATUSES.map { |status| [status.humanize, status] } %>
    <%= label_tag :order_status, "Order status", class: "sr-only" %>
    <%= select_tag :order_status, options_for_select([["All orders", ""], ["Active orders", "active"], ["Canceled orders", "canceled"]], @order_filter), class: "rounded-md border border-neutral-300 bg-white px-4 py-2 text-sm text-neutral-900", data: { action: "change->auto-submit#submit" } %>
    <%= link_to "Clear filters", admin_hostel_bookings_path, class: "text-brand-blue-700 underline self-center" %>
  <% end %>
  <%= render "hostel_bookings/overview", bookings: @hostel_bookings, admin: true %>
</div>
