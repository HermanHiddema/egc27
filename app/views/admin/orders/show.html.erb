<div class="container-wide py-12">
  <div class="flex flex-wrap justify-between items-center gap-4 mb-8">
    <div>
      <p class="text-sm"><%= link_to "Orders", admin_orders_path, class: "text-brand-blue-700 underline" %></p>
      <h1 class="text-4xl font-bold mt-2">Order #<%= @order.id %></h1>
    </div>
    <span class="inline-flex rounded px-3 py-1 font-semibold <%= order_payment_status_class(@order) %>"><%= order_payment_status(@order) %></span>
  </div>

  <section class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm mb-6">
    <h2 class="text-xl font-semibold mb-4">Order information</h2>
    <dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 text-sm">
      <div><dt class="font-semibold text-neutral-700">Submitted</dt><dd class="text-neutral-900"><%= l(@order.created_at, format: :long) %></dd></div>
      <div><dt class="font-semibold text-neutral-700">Payer</dt><dd class="text-neutral-900"><%= @order.user.display_name %><br><span class="text-neutral-500"><%= @order.user.email %></span></dd></div>
      <div><dt class="font-semibold text-neutral-700">Order total</dt><dd class="text-neutral-900"><%= Settlement.format_cents(@order.total_cents) %></dd></div>
      <div><dt class="font-semibold text-neutral-700">Cancelled at</dt><dd class="text-neutral-900"><%= @order.cancelled_at ? l(@order.cancelled_at, format: :long) : "—" %></dd></div>
    </dl>
    <% if @order.cancellable? %>
      <%= button_to "Cancel order", cancel_admin_order_path(@order), method: :patch, class: "btn-secondary mt-5", data: { turbo_confirm: "Cancel Order #{@order.id}? This will release its participant tickets for a new purchase." } %>
    <% end %>
  </section>

  <% if @cancellation_versions.any? %>
    <section class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm mb-6">
      <h2 class="text-xl font-semibold mb-4">Cancellation audit</h2>
      <ul class="space-y-2 text-sm">
        <% @cancellation_versions.each do |version| %>
          <% actor_id = Integer(version.whodunnit, exception: false) %>
          <% actor = @version_actors[actor_id] %>
          <li><%= l(version.created_at, format: :long) %> · <%= actor&.display_name || (version.whodunnit.present? ? "User ##{version.whodunnit}" : "Unknown user") %></li>
        <% end %>
      </ul>
    </section>
  <% end %>

  <section class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm mb-6">
    <h2 class="text-xl font-semibold mb-4">Products</h2>
    <ul class="divide-y divide-gray-200">
      <% @products.each do |product| %>
        <li class="py-4 flex flex-wrap justify-between gap-4">
          <div>
            <% if product.productable.is_a?(ParticipantTicket) %>
              <% participant = product.productable.participant %>
              <%= link_to "#{participant.first_name} #{participant.last_name}", admin_participant_path(participant), class: "font-semibold text-brand-blue-700 underline" %>
              <p class="text-sm text-neutral-600">Participant ticket · <%= CongressPassPricing.new(attendance_option: participant.attendance_option).attendance_label %></p>
              <% if product.productable.invalidated_at %><p class="text-sm text-neutral-600">Ticket invalidated <%= l(product.productable.invalidated_at, format: :long) %></p><% end %>
            <% else %>
              <%= product.productable.description %>
              <p class="text-sm text-neutral-600"><%= eu_date_range(product.productable.arrival_date, product.productable.departure_date) %> · <%= hostel_booking_options(product.productable) %></p>
            <% end %>
          </div>
          <span class="whitespace-nowrap font-medium"><%= Settlement.format_cents(product.price_cents) %></span>
        </li>
      <% end %>
    </ul>
  </section>

  <section class="bg-white border border-gray-200 rounded-lg p-6 shadow-sm">
    <h2 class="text-xl font-semibold mb-4">Payment attempts</h2>
    <% if @payments.any? %>
      <div class="overflow-x-auto">
        <table class="min-w-full divide-y divide-gray-200">
          <thead class="bg-neutral-50"><tr><th class="px-3 py-2 text-left text-xs uppercase">Payment</th><th class="px-3 py-2 text-left text-xs uppercase">Date</th><th class="px-3 py-2 text-left text-xs uppercase">Status</th><th class="px-3 py-2 text-left text-xs uppercase">Method</th><th class="px-3 py-2 text-right text-xs uppercase">Amount</th></tr></thead>
          <tbody class="divide-y divide-gray-100">
            <% @payments.each do |payment| %>
              <tr>
                <td class="px-3 py-2"><%= link_to "##{payment.id}", admin_payment_path(payment), class: "text-brand-blue-700 underline" %></td>
                <td class="px-3 py-2 text-neutral-700"><%= l(payment.payment_date || payment.created_at.to_date, format: :long) %></td>
                <td class="px-3 py-2 text-neutral-700"><%= payment.status.humanize %></td>
                <td class="px-3 py-2 text-neutral-700"><%= payment.payment_method_label || payment.provider_label %></td>
                <td class="px-3 py-2 text-right text-neutral-900"><%= payment.amount_formatted %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
      </div>
    <% else %>
      <p class="text-neutral-700">No payment attempts have been made.</p>
    <% end %>
  </section>
</div>
