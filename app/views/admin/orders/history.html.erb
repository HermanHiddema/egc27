<div class="container-wide py-12">
  <p class="text-sm mb-2"><%= link_to "Orders", admin_orders_path, class: "text-brand-blue-700 underline" %></p>
  <h1 class="text-4xl font-bold mb-8">Order #<%= @order_id %> history</h1>
  <% if @order %>
    <p class="mb-4"><%= link_to "Order details", admin_order_path(@order), class: "text-brand-blue-700 underline" %></p>
  <% else %>
    <p class="mb-4">This draft Order has been deleted.</p>
  <% end %>
  <%= render "history" %>
</div>
